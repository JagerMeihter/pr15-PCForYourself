<Page x:Class="pr15_PCForYourself.Views.SavedBuildsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сохранённые сборки">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0" ItemsSource="{Binding SavedBuilds}" 
                 SelectedItem="{Binding SelectedBuild}" 
                 DisplayMemberPath="Name" Margin="5"/>

        <StackPanel Grid.Column="1" Margin="5" DataContext="{Binding SelectedBuild}">
            <TextBlock Text="Название: " FontWeight="Bold"/>
            <TextBlock Text="{Binding Name}" Margin="0,0,0,10"/>
            <TextBlock Text="Автор: " FontWeight="Bold"/>
            <TextBlock Text="{Binding Author}" Margin="0,0,0,10"/>
            <TextBlock Text="Компоненты:" FontWeight="Bold"/>
            <ItemsControl ItemsSource="{Binding Components.Values}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Margin="20,0,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Общая стоимость: " FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:C}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Загрузить" Command="{Binding DataContext.LoadBuildCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                        Margin="5" Padding="10,5"/>
                <Button Content="Удалить" Command="{Binding DataContext.DeleteBuildCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                        Margin="5" Padding="10,5" Background="LightCoral"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>