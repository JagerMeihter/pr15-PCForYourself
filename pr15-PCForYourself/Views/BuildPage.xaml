<Page x:Class="pr15_PCForYourself.Views.BuildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сборка">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0,0,0,10" Padding="5"/>
            <ComboBox ItemsSource="{Binding Manufacturers}" 
                      SelectedItem="{Binding SelectedManufacturer}" 
                      Margin="0,0,0,10" Padding="5"/>
            <ListBox ItemsSource="{Binding FilteredComponents}" 
                     SelectedItem="{Binding SelectedComponent}" 
                     Height="300" DisplayMemberPath="Name"/>
            <Button Content="Добавить в сборку" Command="{Binding AddComponentCommand}" 
                    Margin="0,10" Padding="5"/>
        </StackPanel>


        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Выбранные комплектующие" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <ListView Grid.Row="1" ItemsSource="{Binding CurrentBuild.SelectedComponents.Values}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding Name}" Width="200"/>
                            <TextBlock Text="{Binding Manufacturer}" Width="100"/>
                            <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Width="80"/>
                            <Button Content="X" 
                                    Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}" 
                                    Background="LightCoral" Margin="5,0" Padding="5,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                <TextBlock Text="Общая стоимость: " FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="{Binding CurrentBuild.TotalPrice, StringFormat={}{0:C}}" FontSize="16"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>